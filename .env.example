# ------------------------------------------------------------------------------
# Self-Healing LLM Gateway Environment Configuration
# ------------------------------------------------------------------------------

# Environment mode ('development', 'staging', 'production')
ENVIRONMENT=development

# Port on which the FastAPI application will listen
PORT=8000

# Host binding for the FastAPI server (0.0.0.0 for Docker containers)
HOST=0.0.0.0

# Async Redis connection URL used for sliding windows, circuit breaker state, idempotency caching, and queues
REDIS_URL=redis://localhost:6379/0

# Groq API Key for fast open-source LLaMA / Mixtral inference (optional if using local Ollama or mocks)
GROQ_API_KEY=your_groq_api_key_here

# Anthropic API Key for high-tier Claude models (optional if using local Ollama or mocks)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# OpenAI API Key for GPT models (optional if using local Ollama or mocks)
OPENAI_API_KEY=your_openai_api_key_here

# Google Gemini API Key (optional)
GEMINI_API_KEY=your_gemini_api_key_here

# Base URL for local Ollama container or local instance
OLLAMA_API_BASE=http://localhost:11434

# Sliding window duration in seconds for tracking provider health metrics (default: 60 seconds)
HEALTH_WINDOW_SECONDS=60

# Minimum number of sample requests in sliding window before a circuit breaker is allowed to trip (prevents flapping on low volume)
BREAKER_MIN_SAMPLES=10

# Failure rate threshold (0.0 to 1.0) above which the circuit breaker trips from CLOSED to OPEN (default: 0.30 or 30%)
BREAKER_FAILURE_RATE_THRESHOLD=0.30

# Cooldown duration in seconds that an OPEN breaker waits before moving to HALF_OPEN state to test recovery
BREAKER_COOLDOWN_SECONDS=30

# Number of consecutive successful probe requests required in HALF_OPEN state to fully heal breaker back to CLOSED
BREAKER_SUCCESSFUL_PROBES_REQUIRED=3

# Safety gate enabling the /chaos testing endpoint (MUST be false in production environments)
ENABLE_CHAOS_ENDPOINT=true

# Time-to-live in seconds for idempotency keys stored in Redis (default: 86400 seconds / 24 hours)
IDEMPOTENCY_TTL_SECONDS=86400

# Maximum number of retry attempts for queued deferrable requests before marking them as permanently failed
MAX_DEFERRABLE_RETRIES=5

# Maximum timeout in seconds a deferrable request may remain queued across retries before failure (default: 600s / 10 minutes)
MAX_DEFERRABLE_TIMEOUT_SECONDS=600

# Base delay in seconds for exponential backoff queueing calculation
QUEUE_BACKOFF_BASE_SECONDS=1.0

# Jitter factor in seconds applied to backoff delays to prevent thundering herd on recovered providers
QUEUE_BACKOFF_JITTER_SECONDS=0.5
