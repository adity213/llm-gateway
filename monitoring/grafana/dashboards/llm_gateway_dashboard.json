{
  "annotations": {
    "list": []
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "id": null,
  "links": [],
  "liveNow": true,
  "panels": [
    {
      "id": 1,
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "type": "timeseries",
      "title": "Panel 1: Requests Per Second by Provider",
      "description": "Throughput breakdown across all upstream providers",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(rate(llm_gateway_requests_total[30s])) by (provider)",
          "legendFormat": "{{provider}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "fillOpacity": 15
          },
          "unit": "reqps"
        }
      }
    },
    {
      "id": 2,
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "type": "timeseries",
      "title": "Panel 2: Error Rate by Error Taxonomy Category",
      "description": "Error breakdown into strict categories (rate_limit, timeout, server_error, etc.)",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(rate(llm_gateway_errors_total[30s])) by (category)",
          "legendFormat": "{{category}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 40
          },
          "unit": "short"
        }
      }
    },
    {
      "id": 3,
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "type": "timeseries",
      "title": "Panel 3: p95 Latency by Provider",
      "description": "95th percentile response latency in seconds",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.95, sum(rate(llm_gateway_request_duration_seconds_bucket[1m])) by (le, provider))",
          "legendFormat": "p95 {{provider}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "lineWidth": 2
          },
          "unit": "s"
        }
      }
    },
    {
      "id": 4,
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "type": "state-timeline",
      "title": "Panel 4: Circuit State Timeline (0=Closed, 1=Half-Open, 2=Open)",
      "description": "Live visualization of circuit breaker state transitions per provider",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "llm_gateway_circuit_state",
          "legendFormat": "{{provider}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": { "text": "CLOSED (Healthy)", "color": "green" },
                "1": { "text": "HALF-OPEN (Probing)", "color": "yellow" },
                "2": { "text": "OPEN (Tripped)", "color": "red" }
              }
            }
          ]
        }
      }
    },
    {
      "id": 5,
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "type": "timeseries",
      "title": "Panel 5: Deferrable Queue Depth Over Time",
      "description": "Number of deferrable requests awaiting retry in Redis queue",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "llm_gateway_queue_depth",
          "legendFormat": "Queue Depth",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 20
          },
          "unit": "short"
        }
      }
    },
    {
      "id": 6,
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "type": "timeseries",
      "title": "Panel 6: Cost per Hour by Tenant and Feature",
      "description": "Real-time cost attribution in USD per tenant and feature",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(increase(llm_gateway_cost_dollars_total[1h])) by (tenant, feature)",
          "legendFormat": "{{tenant}} ({{feature}})",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 50
          },
          "unit": "currencyUSD"
        }
      }
    }
  ],
  "refresh": "5s",
  "schemaVersion": 38,
  "style": "dark",
  "tags": ["llm-gateway", "resilience", "circuit-breaker"],
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": ["5s", "10s", "30s", "1m"]
  },
  "timezone": "browser",
  "title": "Self-Healing LLM Gateway Dashboard",
  "uid": "llm-gateway-main"
}
